  <script>
(() => {
  const $=id=>document.getElementById(id);
  const host=$('game'),mini=$('minimap'),ctx=mini.getContext('2d');
  const roads=[-120,-60,0,60,120],limit=148,held=new Set(),cars=[],people=[],projectiles=[];
  let scene,camera,renderer,sun,ambient,avatar,player,view='third',mode='story',night=false,selected=0,clock=0,last=0,raf=0,ready=false,loading=false,noticeUntil=0,audio;
  const materials={};
  const material=(color,metalness=0,roughness=.78)=>new THREE.MeshStandardMaterial({color,metalness,roughness});
  const box=(parent,w,h,d,x,y,z,mat,cast=false)=>{
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
    mesh.position.set(x,y,z);mesh.castShadow=cast;mesh.receiveShadow=true;parent.add(mesh);return mesh;
  };
  const cylinder=(parent,r,h,x,y,z,mat,segments=12)=>{
    const mesh=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,segments),mat);
    mesh.position.set(x,y,z);mesh.castShadow=true;parent.add(mesh);return mesh;
  };
  const roundedBody=(parent,w,h,d,x,y,z,mat,scaleY=1)=>{
    const mesh=new THREE.Mesh(new THREE.CapsuleGeometry(.5,.82,8,20),mat);
    // CapsuleGeometry is vertical by default; rotate it onto the car's length axis so every panel shares the same chassis orientation.
    mesh.scale.set(w,h*scaleY,d);mesh.rotation.x=Math.PI/2;
    mesh.position.set(x,y,z);mesh.castShadow=true;mesh.receiveShadow=true;parent.add(mesh);return mesh;
  };
  function showLoading(text,percent){
    $('loading-status').textContent=text;
    $('loading-progress').style.width=percent+'%';
  }
  const pause=()=>new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));
  function disposeScene(){
    if(raf)cancelAnimationFrame(raf);
    if(scene){
      const geometries=new Set(),mats=new Set();
      scene.traverse(o=>{if(o.isMesh){geometries.add(o.geometry);(Array.isArray(o.material)?o.material:[o.material]).forEach(m=>mats.add(m))}});
      geometries.forEach(g=>g.dispose());mats.forEach(m=>m.dispose());
    }
    if(renderer){renderer.dispose();renderer.domElement.remove()}
    cars.length=0;people.length=0;projectiles.length=0;held.clear();
  }
  function setup(){
    scene=new THREE.Scene();
    scene.background=new THREE.Color(0x9dbbc0);
    scene.fog=new THREE.FogExp2(0x9dbbc0,.005);
    camera=new THREE.PerspectiveCamera(67,1,.1,410);
    renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:'high-performance'});
    renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,1.7));
    renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;
    renderer.outputColorSpace=THREE.SRGBColorSpace;
    renderer.toneMapping=THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure=1.28;
    host.appendChild(renderer.domElement);
    ambient=new THREE.HemisphereLight(0xe2f0f0,0x445744,2.1);scene.add(ambient);
    sun=new THREE.DirectionalLight(0xffe9bc,2.7);
    sun.position.set(-65,100,45);sun.castShadow=true;
    sun.shadow.mapSize.set(1024,1024);
    Object.assign(sun.shadow.camera,{left:-180,right:180,top:180,bottom:-180});
    sun.shadow.bias=-.0003;scene.add(sun);
    materials.asphalt=material(0x343c3f,0,.94);
    materials.pavement=material(0xa9aca1,0,.94);
    materials.grass=material(0x638771);
    materials.line=material(0xe2c67b);
    materials.white=material(0xe2e5d8);
    materials.dark=material(0x202b2d,.24,.45);
    materials.glass=material(0x4a727b,.32,.18);
    materials.trunk=material(0x655846);
    materials.leaves=material(0x386d4e);
    materials.lamp=new THREE.MeshStandardMaterial({color:0xffe4a2,emissive:0xffdd83,emissiveIntensity:.25});
    box(scene,330,.25,330,0,-.22,0,materials.grass);
  }
  function buildRoads(){
    for(const p of roads){
      box(scene,330,.14,19,0,-.035,p,materials.pavement);
      box(scene,19,.14,330,p,-.035,0,materials.pavement);
      box(scene,330,.025,14,0,.05,p,materials.asphalt);
      box(scene,14,.025,330,p,.05,0,materials.asphalt);
      for(let v=-142;v<145;v+=10){
        if(roads.some(r=>Math.abs(v-r)<11))continue;
        box(scene,4,.012,.16,v,.07,p,materials.line);
        box(scene,.16,.012,4,p,.07,v,materials.line);
      }
      for(let v=-116;v<=116;v+=60){
        for(const s of [-1,1]){
          const pole=cylinder(scene,.12,6,v+s*9,3,p+9,materials.dark,8);
          box(scene,1.5,.13,.24,v+s*9+.65,5.8,p+9,materials.dark);
          const lamp=box(scene,.65,.09,.43,v+s*9+1.3,5.73,p+9,materials.lamp);
          lamp.userData.streetLamp=true;
        }
      }
    }
    // Crosswalk stripes and curb bands add readable street detail without heavy geometry.
    for(const x of roads)for(const z of roads){
      for(let i=-3;i<=3;i++){
        box(scene,1.1,.012,2.5,x+i*1.9,.071,z-10,materials.white);
        box(scene,1.1,.012,2.5,x+i*1.9,.071,z+10,materials.white);
      }
    }
  }
  const facades=[0x879a92,0xb5ab97,0x9a8880,0x82929b,0xc5b7a2,0x747f7b];
  function building(x,z,h,w,d,seed){
    const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
    const wall=material(facades[seed%facades.length],0,.87);
    box(g,w,h,d,0,h/2,0,wall,true);
    box(g,w+.5,.32,d+.5,0,h+.16,0,materials.dark,true);
    box(g,w+.25,.35,d+.25,0,.3,0,materials.pavement);
    // Narrow mullions, inset-looking glass, and floor bands break up broad cuboid faces.
    const win=material(seed%3===0?0x507177:0x728d8a,.24,.32);
    for(let floor=2.6;floor<h-1.1;floor+=3.1){
      box(g,w+.06,.11,d+.06,0,floor-.9,0,materials.pavement);
      for(let u=-w/2+1.7;u<w/2-1;u+=2.7){
        box(g,1.2,1.45,.045,u,floor,d/2+.035,win);
        box(g,1.2,1.45,.045,u,floor,-d/2-.035,win);
        box(g,.06,1.5,.07,u,floor,d/2+.08,materials.dark);
      }
      for(let u=-d/2+1.7;u<d/2-1;u+=2.7){
        box(g,.045,1.45,1.2,w/2+.035,floor,u,win);
        box(g,.045,1.45,1.2,-w/2-.035,floor,u,win);
      }
    }
    box(g,2.1,2.5,.1,0,1.45,d/2+.07,materials.glass);
    if(h>22){
      box(g,w*.45,.55,d*.42,0,h+.55,0,materials.pavement);
      box(g,.12,3,.12,w*.25,h+2,0,materials.dark);
    }
  }
  function tree(x,z){
    const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
    cylinder(g,.22,3.1,0,1.55,0,materials.trunk,9);
    for(const [a,b,c,r] of [[0,4.3,0,2.1],[-1,3.9,.35,1.35],[1,4.15,-.3,1.5]]){
      const leaf=new THREE.Mesh(new THREE.IcosahedronGeometry(r,1),materials.leaves);
      leaf.position.set(a,b,c);leaf.castShadow=true;g.add(leaf);
    }
  }
  function buildBlocks(){
    for(let ix=0;ix<4;ix++)for(let iz=0;iz<4;iz++){
      const cx=-90+ix*60,cz=-90+iz*60;
      for(let k=0;k<4;k++){
        const x=cx+(k%2?13:-13),z=cz+(k>1?13:-13);
        const h=11+((ix*17+iz*11+k*7)%21);
        building(x,z,h,17,17,ix+iz*3+k);
      }
      if((ix+iz)%2===0)tree(cx,cz);
    }
    for(let i=0;i<30;i++){
      const road=roads[i%5],along=-133+((i*47)%267);
      if(roads.some(r=>Math.abs(along-r)<13))continue;
      if(i%2)tree(along,road+11);else tree(road-11,along);
    }
  }
  function person(color){
    const g=new THREE.Group(),coat=material(color),skin=material(0xc79776),pants=material(0x354044);
    const torso=new THREE.Mesh(new THREE.CapsuleGeometry(.29,.85,4,8),coat);
    torso.position.y=1.48;torso.castShadow=true;g.add(torso);
    const head=new THREE.Mesh(new THREE.SphereGeometry(.28,12,10),skin);
    head.position.y=2.35;head.castShadow=true;g.add(head);
    const parts=[];
    for(const side of [-1,1]){
      const arm=cylinder(g,.085,.85,side*.39,1.42,0,coat);
      const leg=cylinder(g,.11,.9,side*.18,.49,0,pants);
      parts.push(arm,leg);
    }
    scene.add(g);return {g,parts};
  }
  function makeCar(type,color){
    const root=new THREE.Group();scene.add(root);
    const isSports=type==='supercar'||type==='staff',isService=type==='police'||type==='emergency';
    const length=isService?7.5:isSports?6.8:6.4;
    const paint=material(color,.38,.25),trim=material(0x161d20,.15,.5),rubber=material(0x171c1e,0,.97);
    const glass=material(0x355864,.36,.14);
    // Build the vehicle around one shared chassis so every component stays aligned and grounded.
    const chassis=roundedBody(root,3.12,.9,length*.96,0,.98,0,paint,.72);
    const hood=roundedBody(root,2.86,.42,length*.42,0,1.42,length*.25,paint,.7);
    hood.rotation.x=-.035;
    const rear=roundedBody(root,2.86,.48,length*.24,0,1.34,-length*.34,paint,.7);
    const cabin=roundedBody(root,2.38,1.22,isSports?2.42:2.82,0,1.84,-.18,glass,.72);
    cabin.rotation.x=-.025;
    roundedBody(root,2.82,.2,length+.12,0,.7,0,trim,.5);
    roundedBody(root,3.16,.22,.3,0,.94,length/2+.05,trim,.5);
    roundedBody(root,3.16,.22,.3,0,.94,-length/2-.05,trim,.5);
    for(const side of [-1,1]){
      for(const z of [-length*.32,length*.32]){
        const wheel=new THREE.Mesh(new THREE.CylinderGeometry(.66,.66,.42,20),rubber);
        wheel.rotation.z=Math.PI/2;wheel.position.set(side*1.58,.66,z);wheel.castShadow=true;root.add(wheel);
        const hub=new THREE.Mesh(new THREE.CylinderGeometry(.31,.31,.44,16),materials.pavement);
        hub.rotation.z=Math.PI/2;hub.position.set(side*1.6,.66,z);root.add(hub);
      }
      const headlight=roundedBody(root,.38,.2,.12,side*1.34,1.52,length*.38,materials.lamp,.55);
      headlight.rotation.y=Math.PI/2;
      const taillight=roundedBody(root,.34,.2,.12,side*1.34,1.48,-length*.43,material(0xb32f31),.55);
      taillight.rotation.y=Math.PI/2;
      box(root,.18,.16,.5,side*1.55,1.72,.58,paint);
    }
    roundedBody(root,1.75,.22,.16,0,1.25,length*.505,trim,.65);
    roundedBody(root,.72,.16,.12,0,1.42,length*.51,materials.lamp,.6);
    if(isSports){
      box(root,3.05,.16,.34,0,2.3,-length*.42,trim);
      box(root,.12,.42,.12,-1.25,2.03,-length*.42,trim);
      box(root,.12,.42,.12,1.25,2.03,-length*.42,trim);
    }
    if(isService){
      const blue=new THREE.MeshStandardMaterial({color:0x3c8aff,emissive:0x3c8aff,emissiveIntensity:0});
      const red=new THREE.MeshStandardMaterial({color:0xff4545,emissive:0xff4545,emissiveIntensity:0});
      const bars=[box(root,.85,.24,.52,-.48,2.63,0,red),box(root,.85,.24,.52,.48,2.63,0,blue)];
      root.userData.bars=bars;
      box(root,3.3,.26,1.1,0,1.15,-1.5,type==='police'?trim:material(0xd74142));
    }
    return root;
  }
  function addCar(x,z,angle,type='civilian',parked=true){
    const colors={civilian:[0xd58d76,0x89aaa7,0xb9a587,0x7b9da4],supercar:[0xe7774d,0xb9ce68],staff:[0xf07b3b],police:[0xe4e9e2],emergency:[0xf1ede3]};
    const color=colors[type][cars.length%colors[type].length];
    const car={x,z,angle,type,parked,lights:false,signal:null,root:makeCar(type,color),speed:type==='supercar'||type==='staff'?26:15};
    cars.push(car);syncCar(car);return car;
  }
  function syncCar(c){c.root.position.set(c.x,0,c.z);c.root.rotation.y=c.angle}
  function buildActors(){
    player={x:-95,z:-60,angle:Math.PI/2,car:null};
    avatar=person(0xc9f064);
    [[-88,-60,0],[-60,-85,Math.PI/2],[18,0,0],[60,33,Math.PI/2],[0,93,0],[-120,34,Math.PI/2]].forEach(([x,z,a],i)=>addCar(x,z,a,i===1?'supercar':i===4?'police':i===5?'emergency':'civilian',i<3));
    for(let i=0;i<16;i++){
      const horizontal=i%2===0,road=roads[Math.floor(i/2)%5],along=-105+(i*29)%210;
      const art=person([0xcc8568,0x7f9baf,0xc6a46d,0x997d99][i%4]);
      people.push({x:horizontal?along:road+10,z:horizontal?road+10:along,horizontal,dir:i%3?-1:1,art});
    }
  }
  function resize(){
    if(!renderer)return;
    const w=host.clientWidth,h=host.clientHeight;
    if(w&&h){renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix()}
  }
  async function start(nextMode){
    if(loading)return;
    loading=true;ready=false;mode=nextMode;
    $('main-menu').hidden=true;$('game-screen').classList.add('hidden');
    $('loading-screen').hidden=false;
    showLoading('Preparing the scene…',8);
    await pause();
    try{
      disposeScene();setup();showLoading('Laying out the streets…',28);await pause();
      buildRoads();showLoading('Adding buildings and greenery…',58);await pause();
      buildBlocks();showLoading('Bringing the city to life…',82);await pause();
      buildActors();view='third';night=false;clock=0;selected=0;
      $('spawn-toggle').hidden=mode!=='sandbox';$('spawn-menu').hidden=true;
      $('game-screen').classList.remove('hidden');resize();syncUI();
      camera.position.set(player.x-8,7,player.z-8);draw();
      showLoading('Ready to explore',100);
      await pause();
      $('loading-screen').hidden=true;ready=true;loading=false;last=performance.now();
      raf=requestAnimationFrame(frame);
      message(mode==='sandbox'?'Sandbox / TEST · Explore freely':'Walking · Find a car');
    }catch(error){
      loading=false;showLoading('The city could not load. Choose a mode to try again.',0);
      $('loading-screen').hidden=true;$('main-menu').hidden=false;
    }
  }
  function message(text){$('status').textContent=text;noticeUntil=clock+2.4}
  function nearestCar(){
    let found=null,best=7;
    for(const c of cars){
      if(c.type==='police'||c.type==='emergency')continue;
      const d=Math.hypot(player.x-c.x,player.z-c.z);
      if(d<best){found=c;best=d}
    }
    return found;
  }
  function syncUI(){
    $('get-in').hidden=!!player.car;$('get-out').hidden=!player.car;
    $('view-status').textContent=view==='first'?'FIRST PERSON':'THIRD PERSON';
    $('first-button').setAttribute('aria-pressed',String(view==='first'));
    $('third-button').setAttribute('aria-pressed',String(view==='third'));
    $('lights-button').setAttribute('aria-pressed',String(!!player.car?.lights));
    $('left-button').setAttribute('aria-pressed',String(player.car?.signal==='left'));
    $('right-button').setAttribute('aria-pressed',String(player.car?.signal==='right'));
    $('attack-button').disabled=!!player.car;
    document.querySelectorAll('[data-weapon]').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.weapon===selected)));
  }
  function action(){
    if(!ready)return;
    if(player.car){
      const c=player.car;
      const x=c.x+Math.cos(c.angle)*4,z=c.z-Math.sin(c.angle)*4;
      if(Math.abs(x)>limit||Math.abs(z)>limit){message('No room to get out here');return}
      player.x=x;player.z=z;player.car=null;c.parked=true;message('Walking · Find a car');
    }else{
      const c=nearestCar();
      if(!c){message('Move closer to a car');return}
      player.car=c;c.parked=false;player.x=c.x;player.z=c.z;player.angle=c.angle;
      message('You are driving');
    }
    syncUI();
  }
  function beep(){
    if(!player.car){message('Get in a car to use the horn');return}
    try{
      audio=audio||new (window.AudioContext||window.webkitAudioContext)();
      audio.resume();
      const o=audio.createOscillator(),gain=audio.createGain();
      o.type='sawtooth';o.frequency.value=310;
      gain.gain.setValueAtTime(.035,audio.currentTime);
      gain.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+.23);
      o.connect(gain);gain.connect(audio.destination);o.start();o.stop(audio.currentTime+.24);
    }catch(e){}
    message('Beep beep!');
  }
  function lights(){
    if(!player.car){message('Get in a car to use headlights');return}
    player.car.lights=!player.car.lights;syncUI();message(player.car.lights?'Headlights on':'Headlights off');
  }
  function signal(side){
    if(!player.car){message('Get in a car to use blinkers');return}
    player.car.signal=player.car.signal===side?null:side;syncUI();
    message(player.car.signal?side+' blinker on':'Blinker off');
  }
  function attack(){
    if(!ready||player.car)return;
    const names=['FISTS','PISTOL','SHOTGUN','RPG'],ranges=[3.5,44,25,68];
    const fx=Math.sin(player.angle),fz=Math.cos(player.angle);
    const target=cars.find(c=>c.type==='police'&&Math.hypot(c.x-player.x,c.z-player.z)<ranges[selected]&&
      (c.x-player.x)*fx+(c.z-player.z)*fz>0);
    if(target){
      const flash=new THREE.Mesh(new THREE.SphereGeometry(selected===3?1.2:.35,10,8),
        new THREE.MeshBasicMaterial({color:selected===3?0xffb456:0xffe7a1,transparent:true,opacity:.85}));
      flash.position.set(target.x,1.3,target.z);scene.add(flash);
      projectiles.push({mesh:flash,age:0});
      message(names[selected]+' hit a police vehicle');
    }else message(names[selected]+' · No target in range');
  }
  function spawn(type){
    if(!ready||mode!=='sandbox')return;
    const x=player.x+Math.sin(player.angle)*7,z=player.z+Math.cos(player.angle)*7;
    if(Math.abs(x)>limit||Math.abs(z)>limit){message('Move away from the city edge');return}
    addCar(x,z,player.angle,type,true);
    $('spawn-menu').hidden=true;message(type.toUpperCase()+' spawned nearby');
  }
  function map(){
    const s=mini.width,to=v=>s/2+v*s/300;
    ctx.fillStyle='#183c38';ctx.fillRect(0,0,s,s);
    ctx.strokeStyle='#789084';ctx.lineWidth=4;
    for(const r of roads){
      ctx.beginPath();ctx.moveTo(0,to(r));ctx.lineTo(s,to(r));ctx.stroke();
      ctx.beginPath();ctx.moveTo(to(r),0);ctx.lineTo(to(r),s);ctx.stroke();
    }
    cars.forEach(c=>{ctx.fillStyle=c.type==='police'?'#f36c68':'#c9f064';ctx.fillRect(to(c.x)-2,to(c.z)-2,4,4)});
    ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(to(player.x),to(player.z),3.3,0,Math.PI*2);ctx.fill();
  }
  function update(dt){
    clock+=dt;
    const forward=Number(held.has('w')||held.has('ArrowUp'))-Number(held.has('s')||held.has('ArrowDown'));
    const steer=Number(held.has('a')||held.has('ArrowLeft'))-Number(held.has('d')||held.has('ArrowRight'));
    player.angle+=steer*(player.car?1.75:2.5)*dt;
    const step=forward*(player.car?player.car.speed:8)*dt;
    const x=player.x+Math.sin(player.angle)*step,z=player.z+Math.cos(player.angle)*step;
    if(Math.abs(x)<limit)player.x=x;
    if(Math.abs(z)<limit)player.z=z;
    if(player.car){Object.assign(player.car,{x:player.x,z:player.z,angle:player.angle});syncCar(player.car)}
    avatar.g.visible=!player.car&&view==='third';
    avatar.g.position.set(player.x,0,player.z);avatar.g.rotation.y=player.angle;
    const gait=forward?Math.sin(clock*10)*.35:0;
    avatar.parts[1].rotation.x=gait;avatar.parts[3].rotation.x=-gait;
    for(const p of people){
      if(p.horizontal){p.x+=p.dir*dt*1.5;if(Math.abs(p.x)>137)p.dir*=-1}
      else{p.z+=p.dir*dt*1.5;if(Math.abs(p.z)>137)p.dir*=-1}
      p.art.g.position.set(p.x,0,p.z);
      p.art.g.rotation.y=p.horizontal?(p.dir>0?Math.PI/2:-Math.PI/2):(p.dir>0?0:Math.PI);
      p.art.parts[1].rotation.x=Math.sin(clock*7+p.x)*.35;
      p.art.parts[3].rotation.x=-p.art.parts[1].rotation.x;
    }
    cars.forEach(c=>{
      if(!c.parked&&c!==player.car){
        c.x+=Math.sin(c.angle)*c.speed*dt*.55;
        c.z+=Math.cos(c.angle)*c.speed*dt*.55;
        if(Math.abs(c.x)>limit||Math.abs(c.z)>limit)c.angle+=Math.PI;
        syncCar(c);
      }
      if(c.root.userData.bars)c.root.userData.bars.forEach((b,i)=>b.material.emissiveIntensity=
        Math.floor(clock*5)%2===i?1.2:.05);
    });
    for(let i=projectiles.length-1;i>=0;i--){
      const p=projectiles[i];p.age+=dt;p.mesh.scale.setScalar(1+p.age*4);p.mesh.material.opacity=Math.max(0,.85-p.age*2);
      if(p.age>.42){scene.remove(p.mesh);p.mesh.geometry.dispose();p.mesh.material.dispose();projectiles.splice(i,1)}
    }
    if(clock>noticeUntil)$('status').textContent=player.car?'Driving · Y headlights':nearestCar()?'Car nearby · E to get in':'Walking · Find a car';
    map();
  }
  const desired=new THREE.Vector3(),look=new THREE.Vector3();
  function draw(){
    if(!renderer||!player)return;
    const fx=Math.sin(player.angle),fz=Math.cos(player.angle);
    if(view==='first'){
      desired.set(player.x+fx*.4,player.car?2.25:2,player.z+fz*.4);
      look.set(player.x+fx*20,player.car?2.2:1.9,player.z+fz*20);
    }else{
      desired.set(player.x-fx*(player.car?12:7),player.car?7:5.5,player.z-fz*(player.car?12:7));
      look.set(player.x,1.4,player.z);
    }
    camera.position.lerp(desired,.19);camera.lookAt(look);
    const color=new THREE.Color(night?0x101f36:0x9dbbc0);
    scene.background.copy(color);scene.fog.color.copy(color);
    ambient.intensity=night?.65:2.1;sun.intensity=night?.25:2.7;
    materials.lamp.emissiveIntensity=night?2:.25;
    if(player.car)player.car.root.visible=view!=='first';
    renderer.render(scene,camera);
    if(player.car)player.car.root.visible=true;
  }
  function frame(now){
    if(!ready)return;
    const dt=Math.min((now-last)/1000,.045);last=now;
    if(!document.hidden)update(dt);
    draw();raf=requestAnimationFrame(frame);
  }
  function goMenu(){
    ready=false;if(raf)cancelAnimationFrame(raf);
    held.clear();$('game-screen').classList.add('hidden');
    $('spawn-menu').hidden=true;$('main-menu').hidden=false;
  }
  $('story-button').addEventListener('click',()=>start('story'));
  $('sandbox-button').addEventListener('click',()=>start('sandbox'));
  $('restart-button').addEventListener('click',()=>start(mode));
  $('menu-button').addEventListener('click',goMenu);
  $('help-button').addEventListener('click',e=>{
    $('instructions').hidden=!$('instructions').hidden;
    e.currentTarget.setAttribute('aria-expanded',String(!$('instructions').hidden));
  });
  $('action-button').addEventListener('click',action);
  $('horn-button').addEventListener('click',beep);
  $('lights-button').addEventListener('click',lights);
  $('left-button').addEventListener('click',()=>signal('left'));
  $('right-button').addEventListener('click',()=>signal('right'));
  $('attack-button').addEventListener('click',attack);
  $('first-button').addEventListener('click',()=>{view='first';syncUI()});
  $('third-button').addEventListener('click',()=>{view='third';syncUI()});
  $('spawn-toggle').addEventListener('click',()=>{$('spawn-menu').hidden=!$('spawn-menu').hidden});
  $('close-spawn').addEventListener('click',()=>{$('spawn-menu').hidden=true});
  $('day-night').addEventListener('click',()=>{night=!night;message(night?'Night mode':'Day mode')});
  document.querySelectorAll('[data-spawn]').forEach(b=>b.addEventListener('click',()=>spawn(b.dataset.spawn)));
  document.querySelectorAll('[data-weapon]').forEach(b=>b.addEventListener('click',()=>{
    selected=+b.dataset.weapon;syncUI();message(['FISTS','PISTOL','SHOTGUN','RPG'][selected]+' selected');
  }));
  document.querySelectorAll('[data-direction]').forEach(b=>{
    const key={up:'ArrowUp',down:'ArrowDown',left:'ArrowLeft',right:'ArrowRight'}[b.dataset.direction];
    b.addEventListener('pointerdown',e=>{e.preventDefault();b.setPointerCapture(e.pointerId);held.add(key);b.classList.add('pressed')});
    const release=()=>{held.delete(key);b.classList.remove('pressed')};
    ['pointerup','pointercancel','lostpointercapture'].forEach(event=>b.addEventListener(event,release));
  });
  window.addEventListener('keydown',e=>{
    if(!ready||e.target instanceof HTMLButtonElement||e.target instanceof HTMLInputElement)return;
    const key=e.key.length===1?e.key.toLowerCase():e.key;
    if(['w','a','s','d','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(key)){
      e.preventDefault();held.add(key);
    }
    if(e.repeat)return;
    if(key==='e'||e.code==='Space'){e.preventDefault();action()}
    else if(key==='r'){view='first';syncUI()}
    else if(key==='t'){view='third';syncUI()}
    else if(key==='h')beep();
    else if(key==='y')lights();
    else if(key==='q')signal('left');
    else if(key==='z')signal('right');
    else if(key==='f')attack();
    else if(key==='4')goMenu();
    else if(['1','2','3','5'].includes(key)){
      selected=key==='5'?3:Number(key)-1;syncUI();
    }
  });
  window.addEventListener('keyup',e=>held.delete(e.key.length===1?e.key.toLowerCase():e.key));
  window.addEventListener('blur',()=>{held.clear();document.querySelectorAll('.pressed').forEach(b=>b.classList.remove('pressed'))});
  window.addEventListener('resize',resize);
})();
</script>
 
